{
  "manifest_version": 3,
  "name": "BOSS CLI 本地连接器",
  "version": "0.1.0",
  "description": "让 BOSS-cli 复用已登录的 Chrome 页面，不导出 Cookie。",
  "minimum_chrome_version": "120",
  "permissions": ["scripting", "storage", "alarms"],
  "host_permissions": ["https://www.zhipin.com/*", "https://zhipin.com/*", "http://127.0.0.1/*"],
  "background": {"service_worker": "worker.mjs", "type": "module"},
  "action": {"default_popup": "popup.html"}
}
